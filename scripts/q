#!/bin/sh
# Read-only query against production over HTTPS.
#
# Railway's SSH gateway refuses a second connection with "duplicate session"
# when a previous one has not closed cleanly, which detached background commands
# cause routinely - it blocked about half of all attempts. This has no such
# state. Usage: scripts/q "SELECT COUNT(*) c FROM jobs"
exec curl -s -X POST \
  -H "Authorization: Bearer $(cat "${EXPORT_TOKEN_FILE:-$HOME/.claude/jobs/eb4f7712/tmp/export_token}")" \
  -H 'Content-Type: application/json' \
  -d "$(python3 -c 'import json,sys; print(json.dumps({"sql": sys.argv[1], "limit": 500}))' "$1")" \
  https://job-finder-production-6560.up.railway.app/api/ops/query
